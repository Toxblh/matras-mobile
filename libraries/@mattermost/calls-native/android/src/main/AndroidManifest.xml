<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.mattermost.callsnative">

    <!-- Required by the Mattermost Calls foreground service. Declared here
         so anyone consuming this library inherits them via manifest merge;
         duplicates in the host app's manifest are deduped by android:name. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- matras: the incoming-call notification opens a full-screen ring on a locked screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- matras: proximity sensor turns the screen off at the ear during a call. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <!-- Keeps the microphone (and, while a video call is active, the
             camera) alive while a Mattermost call is in progress and the
             app is backgrounded. The `camera` type is declared here so the
             service may request it at runtime, but it is only requested
             while video is actually on; see MMCallsForegroundService. -->
        <service
            android:name="com.mattermost.callsnative.MMCallsForegroundService"
            android:foregroundServiceType="microphone|camera"
            android:exported="false" />

        <!-- matras: full-screen incoming-call UI (locked / idle screen). -->
        <activity
            android:name="com.mattermost.callsnative.MMCallsIncomingCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <!-- matras: "Hang up" from the ongoing-call notification. -->
        <receiver
            android:name="com.mattermost.callsnative.MMCallsHangUpReceiver"
            android:exported="false" />
    </application>
</manifest>
